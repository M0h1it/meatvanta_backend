# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database (MySQL) ---
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/star_halal_admin"

# --- Auth ---
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="8h"
COOKIE_NAME="shm_admin_token"

# --- Customer auth (separate from admin auth on purpose) ---
# Must be a DIFFERENT secret from JWT_SECRET, or admin and customer tokens
# would be interchangeable.
CUSTOMER_JWT_SECRET="replace-with-a-different-long-random-string"
CUSTOMER_ACCESS_EXPIRES_IN="1h"
CUSTOMER_ACCESS_COOKIE="shm_customer_token"
CUSTOMER_REFRESH_COOKIE="shm_customer_refresh"

# With no SMS provider wired up yet, "true" returns the OTP in the API response
# and logs it to the console so login is testable. MUST be false in production.
OTP_DEV_MODE="true"

# --- CORS ---
# URL where the admin panel React app runs
ADMIN_APP_ORIGIN="http://localhost:5173"
# URL where the customer-facing site runs
CUSTOMER_APP_ORIGIN="http://localhost:5174"

# --- Seed script (first owner account) ---
ADMIN_SEED_NAME="Owner"
ADMIN_SEED_EMAIL="owner@starhalalmeat.com"
ADMIN_SEED_PASSWORD="change-this-before-running-seed"

# --- Local file storage (product images) ---
# Base URL used to build the public image URL stored on each product.
# Change this to your real domain once deployed.
SERVER_BASE_URL="http://localhost:4000"

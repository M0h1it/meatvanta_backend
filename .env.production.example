# ============================================================
# PRODUCTION (Render). Set these in Render's Environment tab,
# NOT in a committed file.
# ============================================================

NODE_ENV="production"
# Render provides PORT automatically - do not set it yourself.

# --- Database (Aiven MySQL) ---
# Copy the "Service URI" from the Aiven console. Aiven REQUIRES SSL, so the
# ?ssl-mode=REQUIRED suffix must be present or Prisma refuses to connect.
DATABASE_URL="mysql://avnadmin:PASSWORD@HOST.aivencloud.com:PORT/defaultdb?ssl-mode=REQUIRED"

# --- Admin auth ---
JWT_SECRET="generate-a-long-random-string"
JWT_EXPIRES_IN="8h"
COOKIE_NAME="mv_admin_token"

# --- Customer auth (MUST be a different secret from JWT_SECRET) ---
CUSTOMER_JWT_SECRET="generate-a-different-long-random-string"
CUSTOMER_ACCESS_EXPIRES_IN="1h"
CUSTOMER_ACCESS_COOKIE="mv_customer_token"
CUSTOMER_REFRESH_COOKIE="mv_customer_refresh"

# Keep true until a real SMS provider is wired in. In production this means
# the OTP is returned in the API response - fine for a soft launch with the
# owner, NOT fine once strangers can sign up.
OTP_DEV_MODE="true"

# --- Cross-site cookies ---
# API on onrender.com + sites on vercel.app = different sites, so the browser
# drops SameSite=Strict cookies and nobody can log in. Set false once
# everything sits under one domain.
CROSS_SITE_COOKIES="true"

# --- CORS (comma-separated, no trailing slash) ---
ADMIN_APP_ORIGIN="https://meatvanta-admin.vercel.app"
CUSTOMER_APP_ORIGIN="https://meatvanta.vercel.app"

# --- Public base URL of this API ---
SERVER_BASE_URL="https://meatvanta-api.onrender.com"

# --- Product images (Cloudflare R2) ---
# Leave these blank to fall back to local disk (fine locally, NOT on Render -
# the free disk is wiped on every deploy).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="meatvanta-images"
# Bucket's public r2.dev URL, or a custom domain bound to the bucket.
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"

# --- First admin (seed) ---
ADMIN_SEED_NAME="Owner"
ADMIN_SEED_EMAIL="owner@meatvanta.com"
ADMIN_SEED_PASSWORD="set-a-strong-password"

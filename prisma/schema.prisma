generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int         @id @default(autoincrement())
  name        String      @unique @db.VarChar(50)
  label       String      @db.VarChar(100)
  permissions Json
  isSystem    Boolean     @default(false) @map("is_system")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  adminUsers  AdminUser[]

  @@map("roles")
}

model AdminUser {
  id            Int        @id @default(autoincrement())
  name          String     @db.VarChar(100)
  email         String     @unique @db.VarChar(150)
  passwordHash  String     @map("password_hash") @db.VarChar(255)
  isActive      Boolean    @default(true) @map("is_active")
  lastLoginAt   DateTime?  @map("last_login_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  roleId        Int        @map("role_id")
  preferences   Json
  role          Role       @relation(fields: [roleId], references: [id])
  auditLogs     AuditLog[]
  createdOrders Order[]

  @@index([roleId])
  @@map("admin_users")
}

model AuditLog {
  id        Int        @id @default(autoincrement())
  adminId   Int?       @map("admin_id")
  action    String     @db.VarChar(100)
  entity    String?    @db.VarChar(100)
  entityId  Int?       @map("entity_id")
  metadata  Json?
  ipAddress String?    @map("ip_address") @db.VarChar(45)
  createdAt DateTime   @default(now()) @map("created_at")
  admin     AdminUser? @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([action])
  @@map("audit_log")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(100)
  slug      String    @unique @db.VarChar(120)
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  products  Product[]

  @@map("categories")
}

model Product {
  id           Int                  @id @default(autoincrement())
  categoryId   Int                  @map("category_id")
  name         String               @db.VarChar(150)
  description  String?              @db.Text
  imageUrl     String?              @map("image_url") @db.VarChar(500)
  isActive     Boolean              @default(true) @map("is_active")
  sortOrder    Int                  @default(0) @map("sort_order")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  imagePath    String?              @map("image_path") @db.VarChar(500)
  isInStock    Boolean              @default(true) @map("is_in_stock")
  optionGroups ProductOptionGroup[]
  variants     ProductVariant[]
  category     Category             @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id         Int         @id @default(autoincrement())
  productId  Int         @map("product_id")
  label      String      @db.VarChar(50)
  price      Decimal     @db.Decimal(10, 2)
  isInStock  Boolean     @default(true) @map("is_in_stock")
  sortOrder  Int         @default(0) @map("sort_order")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  orderItems OrderItem[]
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variants")
}

model ProductOptionGroup {
  id            Int             @id @default(autoincrement())
  productId     Int             @map("product_id")
  name          String          @db.VarChar(100)
  isRequired    Boolean         @default(false) @map("is_required")
  allowMultiple Boolean         @default(false) @map("allow_multiple")
  sortOrder     Int             @default(0) @map("sort_order")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  options       ProductOption[]

  @@index([productId])
  @@map("product_option_groups")
}

model ProductOption {
  id          Int                @id @default(autoincrement())
  groupId     Int                @map("group_id")
  name        String             @db.VarChar(100)
  extraPrice  Decimal            @default(0.00) @map("extra_price") @db.Decimal(10, 2)
  isAvailable Boolean            @default(true) @map("is_available")
  sortOrder   Int                @default(0) @map("sort_order")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  group       ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("product_options")
}

model Order {
  id                   Int         @id @default(autoincrement())
  orderNumber          String      @unique @map("order_number") @db.VarChar(20)
  customerName         String      @map("customer_name") @db.VarChar(150)
  customerPhone        String      @map("customer_phone") @db.VarChar(20)
  deliveryAddress      String?     @map("delivery_address") @db.Text
  status               String      @default("placed") @db.VarChar(30)
  paymentMethod        String      @default("cod") @map("payment_method") @db.VarChar(20)
  paymentStatus        String      @default("unpaid") @map("payment_status") @db.VarChar(20)
  subtotal             Decimal     @db.Decimal(10, 2)
  deliveryCharge       Decimal     @default(0.00) @map("delivery_charge") @db.Decimal(10, 2)
  discount             Decimal     @default(0.00) @db.Decimal(10, 2)
  total                Decimal     @db.Decimal(10, 2)
  notes                String?     @db.Text
  createdByAdminId     Int?        @map("created_by_admin_id")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")
  deliveryChargeStatus String      @default("confirmed") @map("delivery_charge_status") @db.VarChar(20)
  deliveryDate         DateTime?   @map("delivery_date") @db.Date
  deliveryEndTime      String?     @map("delivery_end_time") @db.VarChar(5)
  deliveryPersonName   String?     @map("delivery_person_name") @db.VarChar(100)
  deliveryStartTime    String?     @map("delivery_start_time") @db.VarChar(5)
  paymentNote          String?     @map("payment_note") @db.VarChar(255)
  paymentVerifiedAt    DateTime?   @map("payment_verified_at")
  upiReceiptText       String?     @map("upi_receipt_text") @db.Text
  upiTransactionId     String?     @map("upi_transaction_id") @db.VarChar(100)
  customerId           Int?        @map("customer_id")
  items                OrderItem[]
  createdByAdmin       AdminUser?  @relation(fields: [createdByAdminId], references: [id])
  customer             Customer?   @relation(fields: [customerId], references: [id])

  @@index([status])
  @@index([createdAt])
  @@index([customerId])
  @@index([createdByAdminId], map: "orders_created_by_admin_id_fkey")
  @@map("orders")
}

model OrderItem {
  id               Int             @id @default(autoincrement())
  orderId          Int             @map("order_id")
  productVariantId Int?            @map("product_variant_id")
  productName      String          @map("product_name") @db.VarChar(150)
  variantLabel     String          @map("variant_label") @db.VarChar(50)
  unitPrice        Decimal         @map("unit_price") @db.Decimal(10, 2)
  quantity         Int
  lineTotal        Decimal         @map("line_total") @db.Decimal(10, 2)
  optionsTotal     Decimal         @default(0.00) @map("options_total") @db.Decimal(10, 2)
  selectedOptions  Json?           @map("selected_options")
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])

  @@index([orderId])
  @@index([productVariantId], map: "order_items_product_variant_id_fkey")
  @@map("order_items")
}

model DeliverySettings {
  id                 Int      @id @default(1)
  availableDays      Json     @map("available_days")
  deliveryStartTime  String   @default("06:00") @map("delivery_start_time") @db.VarChar(5)
  deliveryEndTime    String   @default("11:00") @map("delivery_end_time") @db.VarChar(5)
  sameDayEnabled     Boolean  @default(true) @map("same_day_enabled")
  nextDayEnabled     Boolean  @default(true) @map("next_day_enabled")
  maxAdvanceDays     Int      @default(3) @map("max_advance_days")
  sameDayCutoffTime  String?  @map("same_day_cutoff_time") @db.VarChar(5)
  deliveryChargeMode String   @default("flat") @map("delivery_charge_mode") @db.VarChar(20)
  flatDeliveryCharge Decimal  @default(0.00) @map("flat_delivery_charge") @db.Decimal(10, 2)
  deliveryAreaNote   String   @default("We deliver across Gurugram.") @map("delivery_area_note") @db.VarChar(255)
  updatedAt          DateTime @updatedAt @map("updated_at")
  codEnabled         Boolean  @default(true) @map("cod_enabled")
  upiEnabled         Boolean  @default(true) @map("upi_enabled")
  upiId              String   @default("starhalal@upi") @map("upi_id") @db.VarChar(100)
  upiPayeeName       String   @default("Star Halal Meat Shop") @map("upi_payee_name") @db.VarChar(100)

  @@map("delivery_settings")
}

model Notification {
  id         Int       @id @default(autoincrement())
  type       String    @db.VarChar(50)
  title      String    @db.VarChar(150)
  message    String    @db.VarChar(500)
  entityType String?   @map("entity_type") @db.VarChar(50)
  entityId   Int?      @map("entity_id")
  isRead     Boolean   @default(false) @map("is_read")
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model Customer {
  id            Int                    @id @default(autoincrement())
  name          String                 @db.VarChar(150)
  phone         String                 @unique @db.VarChar(20)
  email         String?                @db.VarChar(150)
  isActive      Boolean                @default(true) @map("is_active")
  lastLoginAt   DateTime?              @map("last_login_at")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  addresses     CustomerAddress[]
  refreshTokens CustomerRefreshToken[]
  orders        Order[]

  @@map("customers")
}

model CustomerAddress {
  id          Int      @id @default(autoincrement())
  customerId  Int      @map("customer_id")
  label       String   @default("Home") @db.VarChar(50)
  addressLine String   @map("address_line") @db.Text
  area        String?  @db.VarChar(150)
  pincode     String?  @db.VarChar(10)
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
}

model OtpRequest {
  id           Int       @id @default(autoincrement())
  phone        String    @db.VarChar(20)
  otpHash      String    @map("otp_hash") @db.VarChar(255)
  expiresAt    DateTime  @map("expires_at")
  attemptCount Int       @default(0) @map("attempt_count")
  consumedAt   DateTime? @map("consumed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([phone])
  @@index([expiresAt])
  @@map("otp_requests")
}

model CustomerRefreshToken {
  id         Int       @id @default(autoincrement())
  customerId Int       @map("customer_id")
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_refresh_tokens")
}

model ShopInfo {
  id              Int      @id @default(1)
  shopName        String   @default("Meat Vanta") @map("shop_name") @db.VarChar(100)
  tagline         String   @default("Fresh Every Morning") @db.VarChar(150)
  yearsInBusiness Int      @default(35) @map("years_in_business")
  phone           String   @default("") @db.VarChar(20)
  whatsappNumber  String   @default("") @map("whatsapp_number") @db.VarChar(20)
  email           String   @default("") @db.VarChar(150)
  addressLine     String   @map("address_line") @db.Text
  mapUrl          String   @default("") @map("map_url") @db.VarChar(500)
  shopHours       String   @default("") @map("shop_hours") @db.VarChar(255)
  aboutStory      String   @map("about_story") @db.Text
  qualityPromise  String   @map("quality_promise") @db.Text
  fssaiNumber     String   @default("") @map("fssai_number") @db.VarChar(50)
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("shop_info")
}
